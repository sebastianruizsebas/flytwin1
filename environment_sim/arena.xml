<?xml version="1.0" encoding="utf-8"?>
<!-- MuJoCo arena for Drosophila odor-plume navigation -->
<mujoco model="fly_arena">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <!-- Default contact properties for realistic friction -->
  <default>
    <geom friction="1.0 0.005 0.0001" condim="4"/>
  </default>

  <worldbody>
    <!-- Arena floor: physical, collideable, with friction -->
    <geom name="floor" type="plane" size="2 2 0.1" pos="0 0 0"
          rgba="0.75 0.75 0.65 1" conaffinity="1" condim="4"
          friction="1.0 0.005 0.0001"/>

    <!-- Wind-tunnel walls: physical collideable barriers -->
    <geom name="wall_upwind"   type="box" size="0.01 1.0 0.5" pos="-1.0 0 0.5"
          rgba="0.5 0.5 0.9 0.5" conaffinity="1" condim="3"/>
    <geom name="wall_downwind" type="box" size="0.01 1.0 0.5" pos=" 1.0 0 0.5"
          rgba="0.5 0.5 0.9 0.5" conaffinity="1" condim="3"/>
    <geom name="wall_left"  type="box" size="1.0 0.01 0.5" pos="0  1.0 0.5"
          rgba="0.5 0.5 0.9 0.5" conaffinity="1" condim="3"/>
    <geom name="wall_right" type="box" size="1.0 0.01 0.5" pos="0 -1.0 0.5"
          rgba="0.5 0.5 0.9 0.5" conaffinity="1" condim="3"/>

    <!-- Odor source: static sphere at arena origin; physical so fly can detect contact -->
    <!-- source_position=zeros in OdorPlume matches this position -->
    <geom name="source" type="sphere" size="0.015" pos="0 0 0.015"
          rgba="1.0 0.3 0.0 1" conaffinity="1" condim="1"
          friction="0.1 0.005 0.0001"/>

    <!-- Obstacle cylinders: physical, collideable -->
    <!-- Positions match OBSTACLES_XY in save_trajectory_video() -->
    <geom name="obstacle_1" type="cylinder" size="0.02 0.1" pos="-0.25  0.15 0.1"
          rgba="0.6 0.3 0.1 1" conaffinity="1" condim="3"/>
    <geom name="obstacle_2" type="cylinder" size="0.02 0.1" pos="-0.25 -0.15 0.1"
          rgba="0.6 0.3 0.1 1" conaffinity="1" condim="3"/>

    <!-- Fly body included via flybody MJCF (Phase 3c) -->
    <!-- <include file="../flybody/fruitfly/assets/fruitfly.xml"/> -->

  </worldbody>

  <sensor>
    <!-- Antennae position sensors — updated when flybody MJCF is included -->
    <framepos name="antenna_left"  objtype="site" objname="antenna_left_site"/>
    <framepos name="antenna_right" objtype="site" objname="antenna_right_site"/>
  </sensor>
</mujoco>
